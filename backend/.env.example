# Lead Qualifier Pipeline Configuration

# Anthropic API (for Claude enrichment)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ElevenLabs API (for voice agent)
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Slack Integration
# Create an app at: https://api.slack.com/apps
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# Base URL for callbacks (use ngrok for local development)
BASE_URL=http://localhost:8000

# Database (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./leads.db
