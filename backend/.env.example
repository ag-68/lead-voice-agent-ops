# Lead Qualifier Pipeline Configuration

# Model used to score a lead. Leave these empty to use the built-in name list.
# Provider: anthropic, openai, gemini, groq, or openai_compatible.
# Both LLM_PROVIDER and LLM_MODEL are required (plus that provider's API key). Keys alone do not select a provider.
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_BASE_URL=

# ElevenLabs voice agent. Key, agent id, and phone number id are required before a real call is placed.
# https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# HMAC secret from Agents settings → Post-Call Webhook (shown once at create).
ELEVENLABS_WEBHOOK_SECRET=

# Slack Integration
# Create an app at: https://api.slack.com/apps
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# Base URL for callbacks (use ngrok for local development)
BASE_URL=http://localhost:8000

# Database (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./leads.db
